# Copy to .env for local infrastructure tooling. Never use these credentials remotely.
# Docker Compose uses the matching fixed credentials in compose.yaml.
DATABASE_URL=postgresql://dogwatch:dogwatch_local_only@127.0.0.1:5433/dogwatch
REDIS_URL=redis://127.0.0.1:6380
# API_PORT defaults to 4000; API/worker environment-file loading is still not enabled.

# API reads the shell environment only; .env is not automatically loaded by API.
# Generate a random webhook secret, then export it when running the API.
# GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters

# Set ALL three in the shell to enable authorization (otherwise verification-only).
# Copy the documented example and replace invented IDs; never commit real keys.
# GITHUB_APP_ID=your-numeric-app-id
# GITHUB_PRIVATE_KEY_FILE=.local/github-app.pem
# GITHUB_POLICIES_FILE=.local/github-policies.json

# Export DATABASE_URL to the API shell only after full GitHub auth and ownership
# registration are configured. It enables durable acceptance, not queue execution.

# Export BOTH URLs to the worker/runner shell to enable outbox dispatch.
# Without either it remains disabled; with only one it refuses startup.
# Production QA consumption is not enabled in this phase.
