# Copy to .env for local infrastructure tooling. Never use these credentials remotely.
# Docker Compose uses the matching fixed credentials in compose.yaml.
DATABASE_URL=postgresql://dogwatch:dogwatch_local_only@127.0.0.1:5433/dogwatch
REDIS_URL=redis://127.0.0.1:6380
# API_PORT defaults to 4000; API/worker environment-file loading is still not enabled.
