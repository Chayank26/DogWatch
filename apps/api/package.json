{
  "name": "@dogwatch/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "predev": "npm run build -w @dogwatch/contracts",
    "prebuild": "npm run build -w @dogwatch/contracts",
    "pretypecheck": "npm run build -w @dogwatch/contracts",
    "pretest": "npm run build -w @dogwatch/contracts"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "express": "^5.2.1",
    "octokit": "^5.0.5",
    "zod": "^4.6.5",
    "@dogwatch/contracts": "0.1.0"
  }
}
