{
  "name": "@dogwatch/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "predev": "npm run build -w @dogwatch/database && npm run build -w @dogwatch/queue",
    "prebuild": "npm run build -w @dogwatch/database && npm run build -w @dogwatch/queue",
    "pretypecheck": "npm run build -w @dogwatch/database && npm run build -w @dogwatch/queue",
    "preverify:queue": "npm run build -w @dogwatch/database && npm run build -w @dogwatch/queue",
    "verify:queue": "node --import tsx src/verify-queue.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "verify:preview": "node --import tsx src/verify-preview.ts",
    "preverify:preview": "npm run build -w @dogwatch/database && npm run build -w @dogwatch/queue",
    "sandbox:build": "docker build --tag dogwatch-sandbox:phase-2.7 sandbox",
    "verify:isolation": "node --import tsx src/verify-isolation.ts",
    "preverify:smoke": "npm run build -w @dogwatch/fixture",
    "verify:smoke": "node --import tsx src/verify-smoke.ts",
    "preverify:baseline": "npm run build -w @dogwatch/fixture",
    "verify:baseline": "node --import tsx src/verify-baseline.ts",
    "pretest": "npm run build -w @dogwatch/fixture",
    "preverify:api": "npm run build -w @dogwatch/fixture",
    "verify:api": "node --import tsx --test src/api-execution.test.ts src/api-authentication.test.ts",
    "preverify:authentication": "npm run build -w @dogwatch/fixture",
    "verify:authentication": "node --import tsx --test src/api-authentication.test.ts"
  },
  "dependencies": {
    "@apidevtools/openapi-schemas": "^2.1.0",
    "@dogwatch/contracts": "0.1.0",
    "@dogwatch/database": "0.1.0",
    "@dogwatch/queue": "0.1.0",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  }
}
