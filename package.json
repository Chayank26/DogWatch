{
  "name": "dogwatch",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,worker \"npm run dev -w @dogwatch/api\" \"npm run dev -w @dogwatch/web\" \"npm run dev -w @dogwatch/worker\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "db:generate": "npm run generate -w @dogwatch/database",
    "db:validate": "npm run validate -w @dogwatch/database",
    "db:migrate": "npm run migrate -w @dogwatch/database",
    "db:status": "npm run migration:status -w @dogwatch/database",
    "db:verify": "npm run verify -w @dogwatch/database"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
