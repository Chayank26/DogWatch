{
  "name": "@dogwatch/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
    "migrate": "prisma migrate deploy",
    "migration:status": "prisma migrate status",
    "build": "npm run generate && tsc -p tsconfig.json",
    "typecheck": "npm run generate && tsc --noEmit",
    "verify": "tsx src/verify.ts",
    "verify:acceptance": "tsx src/verify-acceptance.ts",
    "prebuild": "npm run build -w @dogwatch/contracts",
    "pretypecheck": "npm run build -w @dogwatch/contracts",
    "preverify": "npm run build -w @dogwatch/contracts",
    "preverify:acceptance": "npm run build -w @dogwatch/contracts"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.1",
    "@dogwatch/contracts": "0.1.0"
  }
}
